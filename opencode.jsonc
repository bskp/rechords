{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "chrome_devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest"
            ]
        }
    },
    "permission": {
        "bash": {
            "npm run ci:test": "allow",
            "npm run ci:test:e2e": "allow",
            "head": "allow",
            "cat": "allow",
            "tail": "allow"
        }
    }
}